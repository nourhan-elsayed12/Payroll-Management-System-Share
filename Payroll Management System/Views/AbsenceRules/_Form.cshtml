@model AbsenceRuleFormDto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="FromDays" class="form-label"></label>
        <input asp-for="FromDays" type="number" class="form-control" dir="ltr" autofocus />
        <span asp-validation-for="FromDays" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="ToDays" class="form-label"></label>
        <input asp-for="ToDays" type="number" class="form-control" dir="ltr" />
        <span asp-validation-for="ToDays" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="AbsenceRuleTypeId" class="form-label"></label>
        <select asp-for="AbsenceRuleTypeId" asp-items="ViewBag.Types" class="form-select">
            <option value="">-- اختر النوع --</option>
        </select>
        <span asp-validation-for="AbsenceRuleTypeId" class="text-danger"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="Percentage" class="form-label"></label>
        <input asp-for="Percentage" type="number" step="0.01" class="form-control" dir="ltr" />
        <span asp-validation-for="Percentage" class="text-danger"></span>
    </div>
</div>

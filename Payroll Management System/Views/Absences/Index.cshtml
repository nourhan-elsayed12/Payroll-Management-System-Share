@model PagedResult<AbsenceListItemDto>
@{
    ViewData["Title"] = "تسجيل الغياب";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">تسجيل الغياب</h1>
    <a asp-action="Create" class="btn btn-primary">تسجيل غياب</a>
</div>

<partial name="_Alerts" />

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">لا توجد أيام غياب.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>الموظف</th>
                    <th>تاريخ الغياب</th>
                    <th class="text-end">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var absence in Model.Items)
                {
                    <tr>
                        <td>@absence.EmployeeName</td>
                        <td>@absence.Date.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Delete" asp-route-id="@absence.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="التنقل بين الصفحات">
            <ul class="pagination">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">السابق</a>
                </li>
                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">التالي</a>
                </li>
            </ul>
        </nav>
    }
}

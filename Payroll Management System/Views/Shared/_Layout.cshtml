<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام الرواتب</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Payroll_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="d-print-none">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">نظام الرواتب</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Departments" asp-action="Index">الأقسام</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Employees" asp-action="Index">الموظفين</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Salaries" asp-action="Index">المرتبات</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">الحوافز</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="DepartmentIncentives" asp-action="Index">حوافز الأقسام</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="ServiceYearsIncentives" asp-action="Index">حوافز سنوات الخدمة</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">الحضور والانصراف</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Absences" asp-action="Index">تسجيل الغياب</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="AbsenceRules" asp-action="Index">قواعد الغياب</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">التقارير</a>
                            <ul class="dropdown-menu">
@*                                 <li><a class="dropdown-item" asp-area="" asp-controller="AttendanceReport" asp-action="Index">تقرير الحضور والانصراف</a></li>
 *@                                <li><a class="dropdown-item" asp-area="" asp-controller="AttendanceRdlcReport" asp-action="Index">تقرير الحضور والانصراف </a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="EmployeesReport" asp-action="Index">تقرير العاملين بالشركة</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="IncentivesReport" asp-action="Index">تقرير الحوافز والخصومات</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="SalariesReport" asp-action="Index">تقرير مرتبات العاملين</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted d-print-none">
        <div class="container">
            &copy; 2026 - نظام الرواتب
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

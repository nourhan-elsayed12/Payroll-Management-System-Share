@model List<AttendanceReportRowDto>
@{
    ViewData["Title"] = "تقرير الحضور والانصراف";
    var month = ViewData["Month"] as string;
    var maxMonth = ViewData["MaxMonth"] as string;
    var departmentName = (ViewBag.Departments as SelectList)?.FirstOrDefault(d => d.Selected)?.Text ?? "كل الأقسام";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">تقرير الحضور والانصراف</h1>
    <button type="button" class="btn btn-outline-secondary d-print-none" onclick="window.print()">طباعة</button>
</div>

@* Shown on paper only, since the filter form is hidden when printing *@
<p class="d-none d-print-block">الشهر: @month &nbsp;|&nbsp; القسم: @departmentName</p>

<form method="get" asp-action="Index" class="row g-2 mb-3 d-print-none">
    <div class="col-sm-6 col-md-3">
        <label for="month" class="form-label">الشهر</label>
        <input type="month" id="month" name="month" value="@month" max="@maxMonth" class="form-control" required />
    </div>
    <div class="col-sm-6 col-md-4">
        <label for="departmentId" class="form-label">القسم</label>
        <select id="departmentId" name="departmentId" asp-items="ViewBag.Departments" class="form-select">
            <option value="">كل الأقسام</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">عرض</button>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">لا يوجد موظفين.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>اسم الموظف</th>
                    <th>عدد أيام الغياب</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@row.EmployeeName</td>
                        <td>@row.AbsenceDays</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

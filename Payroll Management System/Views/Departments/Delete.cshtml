@model DepartmentItemDto
@{
    ViewData["Title"] = "حذف قسم";
}

<h1 class="h3 mb-3">حذف قسم</h1>

<div class="card border-danger">
    <div class="card-body">
        <p class="mb-2">هل أنت متأكد من حذف القسم التالي؟</p>
        <dl class="row mb-3">
            <dt class="col-sm-3">اسم القسم</dt>
            <dd class="col-sm-9">@Model.Name</dd>
        </dl>


        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger" disabled="@(Model.EmployeesCount > 0)">تأكيد الحذف</button>
            <a asp-action="Index" class="btn btn-secondary">رجوع</a>
        </form>
    </div>
</div>

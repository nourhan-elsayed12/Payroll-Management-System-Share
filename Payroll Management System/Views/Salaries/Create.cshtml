@model SalaryFormDto
@{
    ViewData["Title"] = "إضافة مرتب";
}

<h1 class="h3 mb-3">إضافة مرتب</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()


            <div class="mb-3">
                <label asp-for="JobGradeId" class="form-label"></label>
                <select asp-for="JobGradeId" asp-items="ViewBag.JobGrades" class="form-select">
                    <option value="">-- اختر الدرجة --</option>
                </select>
                <span asp-validation-for="JobGradeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BaseSalary" class="form-label"></label>
                <input asp-for="BaseSalary" type="number" step="0.01" min="1" class="form-control" dir="ltr" />
                <span asp-validation-for="BaseSalary" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">رجوع</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Payroll_Management_System</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ReportViewerCore.NETCore" Version="15.1.33" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded at runtime with GetManifestResourceStream -->
    <EmbeddedResource Include="Reports\Attendance.rdlc" />
	  <EmbeddedResource Include="Reports\Report1.rdlc" />
    <EmbeddedResource Include="Reports\Employees.rdlc" />
    <EmbeddedResource Include="Reports\Incentives.rdlc" />
    <EmbeddedResource Include="Reports\Salaries.rdlc" />
    <None Remove="Reports\Attendance.rdlc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PayrollManagementSystem.Business\PayrollManagementSystem.Business.csproj" />
    <ProjectReference Include="..\PayrollManagementSystem.DataAccess\PayrollManagementSystem.DataAccess.csproj" />
    <ProjectReference Include="..\PayrollManagementSystem.DTOs\PayrollManagementSystem.DTOs.csproj" />
  </ItemGroup>

</Project>
